package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "Clarifae",

    srcs: ["src/**/*.java"],

    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "com.google.android.material_material",
    ],

    optimize: {
        enabled: false,
    },
}
