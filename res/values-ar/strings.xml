<resources>
    <string name="app_name">Clarifae</string>
    <string name="app_title">نقاء الصوت بالذكاء الاصطناعي</string>
    <string name="tagline">عزل الضوضاء وتحسين الصوت بالذكاء الاصطناعي في الوقت الفعلي</string>
    <string name="tile_label">نقاء الصوت</string>

    <!-- Master Switch -->
    <string name="master_title">محرك نقاء الصوت</string>
    <string name="master_sub_default">عزل الضوضاء من الميكروفون والصوت المسموع في الوقت الفعلي.</string>
    <string name="master_sub_active">نشط — يعمل على تنقية صوت الميكروفون بالذكاء الاصطناعي.</string>
    <string name="master_sub_paused">متوقف مؤقتاً. قم بالتفعيل لتنقية الصوت.</string>

    <!-- What to Clean -->
    <string name="section_what_to_clean">ما يتم تنقيته</string>
    <string name="in_enabled_title">الميكروفون (المدخلات)</string>
    <string name="in_enabled_summary">تنقية صوتك الخارج في المكالمات وتطبيقات التواصل وتسجيل الصوت.</string>
    <string name="out_enabled_title">الصوت المسموع (المخرجات)</string>
    <string name="out_enabled_summary">تنقية الصوت القادم من الطرف الآخر عبر سماعة الأذن ومكبر الصوت.</string>

    <!-- Modes -->
    <string name="section_modes">نمط نقاء الصوت</string>
    <string name="mode_1_name">تأخير منخفض (Low latency)</string>
    <string name="mode_1_pill">RNNoise</string>
    <string name="mode_1_desc">شبكة عصبية متكررة مدمجة. أدنى استهلاك للمعالج وبدون تأخير — الأفضل للمكالمات والميكروفون الدائم.</string>

    <string name="mode_2_name">متوازن (Balanced)</string>
    <string name="mode_2_pill">DTLN</string>
    <string name="mode_2_desc">نموذج LSTM ثنائي الإشارة. عزل ضوضاء أقوى. تجريبي — يتطلب نماذج DTLN.</string>

    <string name="mode_3_name">أقصى نقاء (Maximum clarity)</string>
    <string name="mode_3_pill">DeepFilterNet</string>
    <string name="mode_3_desc">معالجة كاملة النطاق 48 kHz بأعلى جودة صوتية. تجريبي — يتطلب libdf ونموذج المعالجة.</string>

    <string name="hint_fallback_dtln">نماذج DTLN غير مثبتة — سيعمل Clarifae تلقائياً عبر شبكة RNNoise.</string>
    <string name="hint_fallback_df">حزمة DeepFilterNet غير مثبتة — سيعمل Clarifae تلقائياً عبر شبكة RNNoise.</string>

    <!-- Tuning -->
    <string name="section_tuning">الضبط الصوتي الدقيق</string>
    <string name="strength_title">قوة عزل الميكروفون</string>
    <string name="strength_help">نسبة دمج إشارة الميكروفون المنقاة بالذكاء الاصطناعي مع الصوت الأصلي (wet/dry).</string>
    <string name="out_strength_title">قوة عزل الصوت المسموع</string>
    <string name="out_strength_help">نسبة التنقية للمخرجات. قم بخفضها في حال تأثر صوت الموسيقى.</string>
    <string name="atten_db_title">الحد الأقصى لكبح الضوضاء</string>
    <string name="atten_db_help">تحديد سقف خفض الضوضاء لحماية النبرة الطبيعية للصوت البشري.</string>
    <string name="vad_title">حساسية كاشف النشاط الصوتي (بوابة الصمت)</string>
    <string name="vad_help">حساسية كشف الصوت البشري لكتم الضوضاء أثناء فترات الصمت بين الكلمات.</string>
    <string name="highpass_title">مرشح الترددات المنخفضة (High-pass)</string>
    <string name="highpass_help">عزل دمدمة الهواء، صوت الرياح، والترددات المنخفضة جداً دون 80Hz.</string>
    <string name="autogain_title">التعزيز الصوتي التلقائي (Auto gain)</string>
    <string name="autogain_help">رفع مستوى الصوت تلقائياً للمتحدثين البعيدين عن الهاتف بهدوء.</string>

