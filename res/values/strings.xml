<resources>
    <string name="app_name">Clarifae</string>
    <string name="app_title">AI Voice Clarity</string>
    <string name="tagline">Real-time AI audio clarity</string>
    <string name="tile_label">Voice Clarity</string>

    <!-- Master Switch -->
    <string name="master_title">Clarity engine</string>
    <string name="master_sub_default">Clean your microphone and the audio you hear, in real time.</string>
    <string name="master_sub_active">Active — cleaning your microphone.</string>
    <string name="master_sub_paused">Paused. Toggle on to clean your microphone.</string>

    <!-- What to Clean -->
    <string name="section_what_to_clean">What to clean</string>
    <string name="in_enabled_title">Microphone (input)</string>
    <string name="in_enabled_summary">Cleans your outgoing voice on calls &amp; recordings.</string>
    <string name="out_enabled_title">Playback (output)</string>
    <string name="out_enabled_summary">Cleans the audio you hear from the speaker/headphones.</string>

    <!-- Modes -->
    <string name="section_modes">Clarity mode</string>
    <string name="mode_1_name">Low latency</string>
    <string name="mode_1_pill">RNNoise</string>
    <string name="mode_1_desc">Compact RNN denoiser. Lowest CPU and delay — best for calls and always-on mic.</string>

    <string name="mode_2_name">Balanced</string>
    <string name="mode_2_pill">DTLN</string>
    <string name="mode_2_desc">Dual-signal LSTM. Stronger denoising. Experimental — needs DTLN models.</string>

    <string name="mode_3_name">Maximum clarity</string>
    <string name="mode_3_pill">DeepFilterNet</string>
    <string name="mode_3_desc">Full-band 48 kHz enhancement. Highest quality. Experimental — needs libdf + model.</string>

    <string name="hint_fallback_dtln">DTLN models not installed — Clarifae will fall back to RNNoise.</string>
    <string name="hint_fallback_df">DeepFilterNet (libdf/model) not installed — Clarifae will fall back to RNNoise.</string>

    <!-- Tuning -->
    <string name="section_tuning">Tuning</string>
    <string name="strength_title">Microphone strength</string>
    <string name="strength_help">How much of the cleaned mic signal to blend in (wet/dry).</string>
    <string name="out_strength_title">Playback strength</string>
    <string name="out_strength_help">Blend for output cleanup. These are speech models — lower this if music sounds over-processed.</string>
    <string name="atten_db_title">Max suppression</string>
    <string name="atten_db_help">Caps how aggressively noise is attenuated (protects natural tone).</string>
    <string name="vad_title">Voice gate</string>
    <string name="vad_help">Voice-activity sensitivity used for gating and auto-gain.</string>
    <string name="highpass_title">High-pass filter</string>
    <string name="highpass_help">Removes DC offset and low rumble.</string>
    <string name="autogain_title">Auto gain</string>
    <string name="autogain_help">Gently boosts quiet speech (may pump in noise).</string>

